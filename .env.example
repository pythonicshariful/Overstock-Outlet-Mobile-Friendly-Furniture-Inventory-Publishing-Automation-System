# Overstock Outlet System Configuration
APP_NAME="Overstock Outlet - Inventory & Publishing"
APP_ENV="development"
SECRET_KEY="replace-with-a-random-secure-string-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Store Details
STORE_NAME="Overstock Outlet"
STORE_LOCATION="Baltimore, MD, USA"
STORE_FACEBOOK_PAGE_URL="https://www.facebook.com/overstockoutletbmore"
STORE_PHONE="(410) 555-0199"
STORE_HOURS="Mon-Sat: 10AM - 7PM, Sun: 11AM - 5PM"

# Database (Default is SQLite, can point to PostgreSQL)
DATABASE_URL="sqlite:///./overstock.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/overstock"

# Meta Graph API (Facebook Page & Instagram)
META_GRAPH_API_VERSION="v21.0"
META_APP_ID=""
META_APP_SECRET=""
FB_PAGE_ID=""
FB_PAGE_ACCESS_TOKEN=""
IG_USER_ID=""

# Set to false once real Meta API tokens are provided
MOCK_SOCIAL_PUBLISHING=true

