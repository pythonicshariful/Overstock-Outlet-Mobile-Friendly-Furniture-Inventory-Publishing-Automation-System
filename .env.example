# ==============================================================================
# NOTE: NO .env FILE IS REQUIRED!
# ==============================================================================
# Facebook Page Connect, Instagram Business Connect, Store Details, and all 4 AI
# Clients (Google Gemini, OpenAI ChatGPT, Anthropic Claude, Groq Llama) can be
# connected and controlled 100% from the Web UI (/admin -> Connect FB & IG / AI).
# All credentials connected in the UI are saved directly inside overstock.db.
#
# This file is kept ONLY as an optional reference for server-level overrides.
# ==============================================================================

APP_NAME="Overstock Outlet - Inventory & Publishing"
APP_ENV="production"
SECRET_KEY="replace-with-a-random-secure-string-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Store Details (Editable in Web UI -> Admin -> Store & API Setup)
STORE_NAME="Overstock Outlet"
STORE_LOCATION="Baltimore, MD, USA"
STORE_FACEBOOK_PAGE_URL="https://www.facebook.com/overstockoutletbmore"
STORE_PHONE=""
STORE_HOURS="Mon-Sat: 10AM - 7PM, Sun: 11AM - 5PM"

# Database (Default is SQLite, can point to PostgreSQL)
DATABASE_URL="sqlite:///./overstock.db"

# Meta Graph API (Connectable in 1-Click from Web UI -> Admin -> Connect FB & IG)
META_GRAPH_API_VERSION="v21.0"
META_APP_ID=""
META_APP_SECRET=""
FB_PAGE_ID=""
FB_PAGE_ACCESS_TOKEN=""
IG_USER_ID=""

# Multi-Provider AI Copywriting (Connectable from Web UI -> Admin -> AI Copywriting)
AI_PROVIDER="auto"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
AI_CUSTOM_PROMPT=""
